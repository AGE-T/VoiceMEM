# ==============================================================================
# config/.env.example - M0/M1 dotenv template (V1 spec 18.1, config/env.local.* mirror)
# ==============================================================================
# The M1 installer (scripts/install_m1.ps1, step 18) copies this file to
# <repo-root>/.env on the target machine; the agent's dotenv loader
# (app/config.py AgentConfig.apply_env) reads KEY=value lines from it AFTER
# config/env.local.ps1 has been dot-sourced, so every key below must be a
# REAL, supported environment variable contract - no cloud API host is
# ever contacted: the endpoint is ALWAYS the local llama-server loopback.
#
# Mirrors: config/env.local.ps1 (Windows) and config/env.local.sh (POSIX).
# Values with $Root- style paths are repo-relative here (dotenv has no
# variables): the loader resolves them against VOICEMEM_HOME (repo root).
#
# WARNING (offline first): set these AFTER the model download
# (scripts/download_models.ps1) - HF_HUB_OFFLINE=1 blocks downloads.

# --- HF cache isolation (M0): project-local, never the user profile ---------
HF_HOME=models/hf
HF_HUB_CACHE=models/hf/hub
TRANSFORMERS_CACHE=models/hf/transformers

# --- Offline mode (spec 11.3 / 18.1): zero runtime network dependency -------
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
TOKENIZERS_PARALLELISM=false

# --- VoiceMem runtime (the voicemem package AND app AgentConfig read these) -
VOICEMEM_MEMORY_ROOT=memory
VOICEMEM_E5_MODEL=models/embedding/multilingual-e5-small
VOICEMEM_EMBED_DIM=384

# --- LLM endpoint: the local llama.cpp llama-server (OpenAI-compatible) -----
# Dummy key is a technical requirement of the `openai` python lib; there is
# NO real API key and NO cloud endpoint (the OpenAI host is never contacted).
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=not-needed-but-required-by-openai-lib
OPENAI_MODEL=qwen3.6-35b-a3b
LLM_DISABLE_THINKING=1

# --- TTS: Piper instead of OpenAI TTS ----------------------------------------
TTS_BACKEND=local

# --- llama-server loopback (start_llama_server.ps1) -------------------------
LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8080
